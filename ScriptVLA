        if oldCube then oldCube:Destroy() end
    end)

    local function positionSkyCube(center)
        local s = SKY_SIZE
        for _, part in ipairs(skyCubeWalls) do
            if part and part.Parent then
                if part.Name == "WallRight" then
                    part.CFrame = CFrame.new(center + Vector3.new(s, 0, 0))
                elseif part.Name == "WallLeft" then
                    part.CFrame = CFrame.new(center - Vector3.new(s, 0, 0))
                elseif part.Name == "WallTop" then
                    part.CFrame = CFrame.new(center + Vector3.new(0, s, 0))
                elseif part.Name == "WallBottom" then
                    part.CFrame = CFrame.new(center - Vector3.new(0, s, 0))
                elseif part.Name == "WallFront" then
                    part.CFrame = CFrame.new(center + Vector3.new(0, 0, s))
                elseif part.Name == "WallBack" then
                    part.CFrame = CFrame.new(center - Vector3.new(0, 0, s))
                end
            end
        end
    end

    local function createSkyWall(name, size)
        local part = Instance.new("Part")
        part.Name = name
        part.Size = size
        part.Anchored = true
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.CastShadow = false
        part.Material = Enum.Material.SmoothPlastic
        part.Reflectance = 0
        part.Color = skyColor
        part.Transparency = 0
        part.TopSurface = Enum.SurfaceType.Smooth
        part.BottomSurface = Enum.SurfaceType.Smooth
        part.Parent = skyCubeFolder
        table.insert(skyCubeWalls, part)
    end

    local function removeSkyCube()
        if skyCubeConnection then
            skyCubeConnection:Disconnect()
            skyCubeConnection = nil
        end
        _G.VSA_SkyCubeConnection = nil
        if skyCubeFolder then
            skyCubeFolder:Destroy()
            skyCubeFolder = nil
        end
        table.clear(skyCubeWalls)
        skyCubeEnabled = false
    end

    local function setSkyColor(color)
        skyColor = color
        for _, part in ipairs(skyCubeWalls) do
            if part and part.Parent then
                part.Color = color
            end
        end
    end

    local function createSkyCube()
        if skyCubeFolder then return end
        skyCubeFolder = Instance.new("Folder")
        skyCubeFolder.Name = "VSA_SkyboxCube"
        skyCubeFolder.Parent = workspace

        local s = SKY_SIZE
        local t = SKY_WALL_THICKNESS
        createSkyWall("WallRight", Vector3.new(t, s * 2, s * 2))
        createSkyWall("WallLeft", Vector3.new(t, s * 2, s * 2))
        createSkyWall("WallTop", Vector3.new(s * 2, t, s * 2))
        createSkyWall("WallBottom", Vector3.new(s * 2, t, s * 2))
        createSkyWall("WallFront", Vector3.new(s * 2, s * 2, t))
        createSkyWall("WallBack", Vector3.new(s * 2, s * 2, t))

        skyCubeEnabled = true
        local camera = workspace.CurrentCamera
        positionSkyCube(camera and camera.CFrame.Position or Vector3.new(0, 100, 0))
        skyCubeConnection = RunService.RenderStepped:Connect(function()
            if not skyCubeEnabled or not skyCubeFolder then return end
            local currentCamera = workspace.CurrentCamera
            if currentCamera then
                positionSkyCube(currentCamera.CFrame.Position)
            end
        end)
        _G.VSA_SkyCubeConnection = skyCubeConnection
    end

