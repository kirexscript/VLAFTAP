        elseif input.KeyCode == Enum.KeyCode.H then
            toggleSakura()
            notify("VSA", "Sakura " .. (state.sakura and "ON" or "OFF"))
        elseif input.KeyCode == Enum.KeyCode.J then
            toggleWings()
            notify("VSA", "Wings " .. (state.wings and "ON" or "OFF"))
        elseif input.KeyCode == Enum.KeyCode.K then
            toggleHalo()
            notify("VSA", "Halo " .. (state.halo and "ON" or "OFF"))
        elseif input.KeyCode == Enum.KeyCode.L then
            setAllFX(not state.allFX)
        end
    end)

    --==========================================================
    -- ANIMATED NOTIFICATIONS (custom toast on HUD)
    --==========================================================

    local function animatedNotice(message)
        if not hudGui then
            notify("VSA", message)
            return
        end

        local toast = Instance.new("TextLabel")
        toast.Size = UDim2.fromOffset(280, 42)
        toast.Position = UDim2.new(1, 300, 1, -75)
        toast.BackgroundColor3 = currentTheme.panel
        toast.TextColor3 = currentTheme.text
        toast.Text = "🌸  " .. message
        toast.Font = Enum.Font.GothamBold
        toast.TextSize = 13
        toast.Parent = hudGui

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 10)
        corner.Parent = toast

        local stroke = Instance.new("UIStroke")
        stroke.Color = currentTheme.accent
        stroke.Parent = toast

        local enter = TweenService:Create(
            toast,
            TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
            { Position = UDim2.new(1, -300, 1, -75) }
        )
        enter:Play()

        task.delay(2.2, function()
            if toast and toast.Parent then
                local exit = TweenService:Create(
                    toast,
                    TweenInfo.new(0.25),
                    {
                        Position = UDim2.new(1, 300, 1, -75),
                        TextTransparency = 1,
                        BackgroundTransparency = 1
                    }
                )
                exit:Play()
                exit.Completed:Connect(function()
                    if toast then toast:Destroy() end
                end)
            end
        end)
    end

    do
        local sec = Utilities:AddSection("Test")
        sec:AddButton({
            Name = "Test Animated Notification",
            Callback = function()
                animatedNotice("VSA is ready!")
            end
        })
    end

    --==========================================================
    -- RESPAWN HANDLER
    --==========================================================

    local function onCharacterAdded(character)
        task.wait(1)
        if state.accessories then createAccessories() end
        if state.aura then createAura() end
        if state.sakura then createPetals() end
        if state.wings then createWings() end
        if state.halo then createHalo() end
        if state.outline then createOutline() end
        if state.trail then createTrail() end
        hookLanding(character)
    end

    Player.CharacterAdded:Connect(onCharacterAdded)

    --==========================================================
    -- FPS / PING / MAIN UPDATE
    --==========================================================

    local frameCount = 0
    local fpsTimer = 0
    local fps = 0
    local ping = "--"
    local pingTimer = 0
    local statusTimer = 0
    local effectUpdateTimer = 0
    local effectUpdateInterval = 1 / 30

    local function readPing()
        local success, result = pcall(function()
            local network = Stats:FindFirstChild("Network")
            local serverStats = network and network:FindFirstChild("ServerStatsItem")
            local pingItem = serverStats and serverStats:FindFirstChild("Data Ping")
            return pingItem and pingItem:GetValueString()
        end)
        return success and result and tostring(result) or "--"
    end

    RunService.Heartbeat:Connect(function(dt)
        frameCount = frameCount + 1
        fpsTimer = fpsTimer + dt
        pingTimer = pingTimer + dt
        statusTimer = statusTimer + dt

        if fpsTimer >= 1 then
            fps = math.floor(frameCount / fpsTimer)
            frameCount = 0
            fpsTimer = 0
        end

        if pingTimer >= 1 then
            ping = readPing()
            pingTimer = 0
            if statsText then
                statsText.Text = string.format("FPS %d | Ping %s", fps, ping)
            end
        end

        if statusTimer >= 0.2 then
            statusTimer = 0
            if statusText then
                statusText.Text = "  VSA | FX " .. (state.allFX and "ON" or "OFF")
            end
            if speedText then
                local root = getRoot()
                if root then
                    local velocity = root.AssemblyLinearVelocity
                    local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
                    speedText.Text = string.format("SPEED %.1f", speed)
                end
            end
            if jumpText then
                local character = Player.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    jumpText.Text = humanoid.FloorMaterial == Enum.Material.Air
                        and "AIRBORNE" or "GROUND"
                end
            end
        end

        effectUpdateTimer = effectUpdateTimer + dt
        if effectUpdateTimer >= effectUpdateInterval then
            local effectDt = effectUpdateTimer
            effectUpdateTimer = 0

            if state.palletsRainbow then
                palletTime = palletTime + effectDt
                setPallets(Color3.fromHSV((palletTime * state.palletSpeed) % 1, 1, 1))
            elseif state.pallets then
                setPallets(state.palletColor)
            end

            if state.linesRainbow and state.allFX then
                lineTime = lineTime + effectDt
                setLines(Color3.fromHSV((lineTime * state.lineSpeed) % 1, 1, 1))
            elseif state.lines then
                setLines(state.lineColor)
            end

            if state.accessories and state.allFX then
                accessoryTime = accessoryTime + effectDt
                updateAccessories()
            end

            if state.aura then
                auraTime = auraTime + effectDt
                updateAura()
            end

            if state.sakura then
                updatePetals(effectDt)
            end

            if state.wings and state.allFX then
                wingTime = wingTime + effectDt
                updateWings()
            end

            if state.halo then
                haloTime = haloTime + effectDt
                updateHalo()
            end

            if state.hearts or state.runes or state.galaxy then
                orbitTime = orbitTime + effectDt
                if state.galaxy then
                    updateOrbiters("Galaxy", true, state.galaxyColor)
                elseif state.runes then
                    updateOrbiters("Runes", true, state.runesColor)
                elseif state.hearts then
                    updateOrbiters("Hearts", true, state.heartsColor)
                end
            end

            if state.outline and characterHighlight then
                outlineTime = outlineTime + effectDt
                if state.outlineRainbow and state.allFX then
                    local color = Color3.fromHSV((outlineTime * 0.15) % 1, 1, 1)
                    characterHighlight.OutlineColor = color
                    characterHighlight.FillColor = color
                else
                    characterHighlight.OutlineColor = state.outlineColor
                    characterHighlight.FillColor = state.outlineColor
                end
                characterHighlight.Enabled = state.allFX
            end

            if state.trail and characterTrail then
                if state.trailRainbow and state.allFX then
                    trailTime = trailTime + effectDt
                    state.trailColor = Color3.fromHSV((trailTime * 0.2) % 1, 1, 1)
                end
                characterTrail.Color = ColorSequence.new(state.trailColor)
                characterTrail.Enabled = state.allFX
            end

            if state.afterimage and state.allFX then
                afterimageTimer = afterimageTimer + effectDt
                if afterimageTimer >= 0.12 then
                    afterimageTimer = 0
                    spawnAfterimage()
                end
            end
        end

        if topBar then
            topBar.Visible = state.hudEnabled
        end
        if statusText then
            statusText.Visible = state.hudEnabled
        end
        if floatingButton then
            floatingButton.Visible = state.floatingButton
        end
        if speedText then
            speedText.Visible = state.speedHUD
        end
        if jumpText then
            jumpText.Visible = state.jumpIndicator
        end
    end)

    --==========================================================
    -- INITIALIZE
    --==========================================================

    task.defer(function()
        task.wait(0.5)
        buildHUD()
        updateHUDTheme()

        if Player.Character then
            hookLanding(Player.Character)
        end

        animatedNotice("Anime / Sakura loaded!")
    end)

    notify(
        "VSA",
        "Loaded | G Aura | H Sakura | J Wings | K Halo | L FX | RightControl Menu"
    )
end)

if not ok then
    warn("[VSA] Error: " .. tostring(err))
end
