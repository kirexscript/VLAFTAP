    local function landingRing()
        if not state.landingEffect or not state.allFX then
            return
        end

        local root = getRoot()
        if not root then
            return
        end

        local ring = Instance.new("Part")
        ring.Name = "VSA_LandingRing"
        ring.Shape = Enum.PartType.Cylinder
        ring.Size = Vector3.new(0.1, 1, 1) * state.effectScale
        ring.Material = Enum.Material.Neon
        ring.Color = C.Sakura
        ring.Transparency = 0.2
        ring.Anchored = true
        ring.CanCollide = false
        ring.CanTouch = false
        ring.CanQuery = false
        ring.CastShadow = false
        ring.CFrame = CFrame.new(root.Position - Vector3.new(0, 2.6, 0))
            * CFrame.Angles(0, 0, math.rad(90))
        ring.Parent = workspace

        local tween = TweenService:Create(
            ring,
            TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {
                Size = Vector3.new(0.1, 8, 8) * state.effectScale,
                Transparency = 1
            }
        )
        tween:Play()
        tween.Completed:Connect(function()
            ring:Destroy()
        end)
    end

    local lastHumanoidState

    local function hookLanding(character)
        local humanoid = character:WaitForChild("Humanoid", 5)
        if not humanoid then
            return
        end

        lastHumanoidState = humanoid:GetState()
        humanoid.StateChanged:Connect(function(_, newState)
            if newState == Enum.HumanoidStateType.Landed
                or newState == Enum.HumanoidStateType.Running then
                if lastHumanoidState == Enum.HumanoidStateType.Freefall
                    or lastHumanoidState == Enum.HumanoidStateType.Jumping then
                    landingRing()
