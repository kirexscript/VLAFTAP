    local function createWings()
        clearWings()
        local character = Player.Character
        local torso = character and (
            character:FindFirstChild("UpperTorso")
            or character:FindFirstChild("Torso")
            or character:FindFirstChild("HumanoidRootPart")
        )
        if not torso then
            return false
        end

        wingsModel = Instance.new("Model")
        wingsModel.Name = "VSA_Wings"
        wingsModel.Parent = character

        for side = -1, 1, 2 do
            for i = 1, 4 do
                local part = Instance.new("Part")
                part.Name = "WingFeather"
                part.Size = Vector3.new(0.18, 0.85, 0.28) * state.effectScale
                part.Material = Enum.Material.Neon
                part.Color = state.wingsColor
                part.CanCollide = false
                part.CanTouch = false
                part.CanQuery = false
                part.Massless = true
                part.CastShadow = false
                part.Anchored = false

                local base = torso.CFrame
                    * CFrame.new(
                        side * (0.65 + i * 0.23) * state.effectScale,
                        (0.45 - i * 0.12) * state.effectScale,
                        0.45 * state.effectScale
                    )
                    * CFrame.Angles(0, 0, math.rad(side * (15 + i * 10)))

                part.CFrame = base
                part.Parent = wingsModel

                local weld = Instance.new("Weld")
                weld.Part0 = torso
                weld.Part1 = part
                weld.C0 = torso.CFrame:ToObjectSpace(base)
                weld.C1 = CFrame.new()
                weld.Parent = part

                table.insert(wings, {
                    part = part,
                    weld = weld,
                    base = weld.C0,
                    side = side,
                    index = i
                })
            end
        end

        return true
    end

    local function updateWings()
        for _, item in ipairs(wings) do
            if item.part and item.part.Parent and item.weld and item.weld.Parent then
                local flap = math.sin(wingTime * 5 + item.index * 0.3) * 0.22
                item.weld.C0 = item.base * CFrame.Angles(0, 0, flap * item.side)

                item.part.Transparency = state.allFX and 0 or 1

                if state.wingsRainbow then
                    item.part.Color = Color3.fromHSV(
                        (wingTime * 0.15 + item.index * 0.08) % 1, 0.8, 1
                    )
                else
                    item.part.Color = state.wingsColor
                end
            end
        end
    end

