    --==========================================================
    -- SAVE / LOAD CONFIGS (custom VSA state, independent of library flags)
    --==========================================================

    local configFolder = "VSA/Configs"
    local configName = "SakuraDream"

    local function cleanName(name)
        return tostring(name or ""):gsub("[^%w_%-]", "")
    end

    local function fileAPIsAvailable()
        return type(writefile) == "function"
            and type(readfile) == "function"
            and type(isfile) == "function"
            and type(makefolder) == "function"
    end

    local function ensureConfigFolder()
        pcall(function()
            if type(isfolder) == "function" then
                if not isfolder("VSA") then makefolder("VSA") end
                if not isfolder(configFolder) then makefolder(configFolder) end
            else
                makefolder("VSA")
                makefolder(configFolder)
            end
        end)
    end

    local function serializeState()
        local data = {}
        for key, value in pairs(state) do
            if typeof(value) == "Color3" then
                data[key] = colorArray(value)
            elseif type(value) == "string"
                or type(value) == "number"
                or type(value) == "boolean" then
                data[key] = value
            end
        end
        return HttpService:JSONEncode(data)
    end

    local function saveConfig(name)
        if not fileAPIsAvailable() then
            notify("VSA", "This executor does not expose file APIs.")
            return
        end

        name = cleanName(name)
        if name == "" then
            notify("VSA", "Enter a valid config name.")
            return
        end

        local okSave, message = pcall(function()
            ensureConfigFolder()
            writefile(configFolder .. "/" .. name .. ".json", serializeState())
        end)

        notify("VSA", okSave and ("Saved " .. name) or tostring(message))
    end

    local function loadConfig(name)
        if not fileAPIsAvailable() then
            notify("VSA", "This executor does not expose file APIs.")
            return
        end

        name = cleanName(name)
        local path = configFolder .. "/" .. name .. ".json"

        if name == "" or not isfile(path) then
            notify("VSA", "Config not found.")
            return
        end

        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(path))
        end)

        if not success or type(data) ~= "table" then
            notify("VSA", "Config file is invalid.")
            return
        end

        for key, value in pairs(data) do
            if state[key] ~= nil then
                if typeof(state[key]) == "Color3" then
                    state[key] = arrayColor(value, state[key])
                elseif type(state[key]) == type(value) then
                    state[key] = value
                end
            end
        end

        applyFog()
        updateLightingEffects()

        if state.accessories then createAccessories() else clearAccessories() end
        if state.aura then createAura() else clearAura() end
        if state.sakura then createPetals() else clearPetals() end
        if state.wings then createWings() else clearWings() end
        if state.halo then createHalo() else clearHalo() end
        if state.outline then createOutline() else clearOutline() end
        if state.trail then createTrail() else clearTrail() end

        notify("VSA", "Loaded " .. name)
    end

