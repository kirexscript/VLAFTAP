    --==========================================================
    -- AURA
    --==========================================================

    local auraPart
    local auraLight
    local auraTime = 0

    local function clearAura()
        if auraPart then
            auraPart:Destroy()
            auraPart = nil
            auraLight = nil
        end
    end

    local function createAura()
        clearAura()
        local root = getRoot()
        if not root then
            return false
        end

        local part = Instance.new("Part")
        part.Name = "VSA_Aura"
        part.Shape = Enum.PartType.Ball
        part.Size = Vector3.one * state.auraSize * state.effectScale
        part.Material = Enum.Material.ForceField
        part.Color = state.auraColor
        part.Transparency = state.auraTransparency
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.Massless = true
        part.CastShadow = false
        part.CFrame = root.CFrame
        part.Parent = Player.Character

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = root
        weld.Part1 = part
        weld.Parent = part

        auraPart = part

        auraLight = Instance.new("PointLight")
        auraLight.Color = state.auraColor
        auraLight.Brightness = 1
        auraLight.Range = state.auraSize * 2
        auraLight.Parent = part

        return true
    end

    local function updateAura()
        if not auraPart or not auraPart.Parent then
            return
        end

        local color = state.auraColor
        if state.auraRainbow and state.allFX then
            color = Color3.fromHSV((auraTime * 0.2) % 1, 0.8, 1)
        end

        auraPart.Color = color
        auraPart.Transparency = state.allFX and state.auraTransparency or 1
        auraPart.Size = Vector3.one * state.auraSize * state.effectScale

        if auraLight then
            auraLight.Color = color
            auraLight.Range = state.auraSize * 2
        end
    end

    do
        local sec = VisualFX:AddSection("Sakura Aura")
        sec:AddToggle({
            Name = "Enable Aura",
            Default = false,
            Callback = function(v)
                state.aura = v
                if v then createAura() else clearAura() end
            end
        })
        sec:AddColorPicker({
            Name = "Aura Color",
            Default = state.auraColor,
            Callback = function(v)
                state.auraColor = v
                updateAura()
            end
        })
        sec:AddToggle({
            Name = "Rainbow Aura",
            Default = false,
            Callback = function(v)
                state.auraRainbow = v
            end
        })
        sec:AddSlider({
            Name = "Aura Size",
            Min = 2,
            Max = 12,
            Default = 5,
            Increment = 1,
            Callback = function(v)
                state.auraSize = v
                updateAura()
            end
        })
        sec:AddSlider({
            Name = "Aura Transparency",
            Min = 0,
            Max = 95,
            Default = 55,
            Increment = 5,
            Callback = function(v)
                state.auraTransparency = v / 100
                updateAura()
            end
        })
    end

    --==========================================================
    -- SAKURA PETALS
    --==========================================================

    local sakuraFolder
    local petals = {}
    local sakuraTime = 0

    local function clearPetals()
        if sakuraFolder then
            sakuraFolder:Destroy()
            sakuraFolder = nil
        end
        table.clear(petals)
    end

    local function createPetals()
        clearPetals()
        sakuraFolder = Instance.new("Folder")
        sakuraFolder.Name = "VSA_Sakura"
        sakuraFolder.Parent = workspace

        for _ = 1, state.sakuraCount do
            local part = Instance.new("Part")
            part.Name = "SakuraPetal"
            part.Shape = Enum.PartType.Ball
            part.Size = Vector3.new(0.14, 0.05, 0.18) * state.effectScale
            part.Material = Enum.Material.Neon
            part.Color = state.sakuraColor
            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.CastShadow = false
            part.Parent = sakuraFolder

            table.insert(petals, {
                part = part,
                angle = Random:NextNumber(0, math.pi * 2),
                radius = Random:NextNumber(2, 5),
                height = Random:NextNumber(-1, 4),
                drift = Random:NextNumber(0.5, 1.5)
            })
        end
    end

    local function updatePetals(dt)
        if not state.sakura or not state.allFX then
            return
        end

        local root = getRoot()
        if not root then
            return
        end

        sakuraTime = sakuraTime + dt

        for _, item in ipairs(petals) do
            if item.part and item.part.Parent then
                item.angle = item.angle + dt * item.drift * state.sakuraSpeed
                item.height = item.height - dt * item.drift * state.sakuraSpeed

                if item.height < -3 then
