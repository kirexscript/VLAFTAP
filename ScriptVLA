    local function createOrbiters(kind, count, color)
        clearOrbiters()
        orbitFolder = Instance.new("Folder")
        orbitFolder.Name = "VSA_" .. kind
        orbitFolder.Parent = workspace

        for i = 1, count do
            local part = Instance.new("Part")
            part.Name = kind .. "Particle"
            part.Shape = Enum.PartType.Ball
            part.Size = Vector3.one * 0.18 * state.effectScale
            part.Material = Enum.Material.Neon
            part.Color = color
            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.CastShadow = false
            part.Parent = orbitFolder

            table.insert(orbiters, {
                part = part,
                angle = math.rad((i - 1) * (360 / count)),
                radius = kind == "Galaxy" and Random:NextNumber(2, 5) or 2,
                height = Random:NextNumber(-1, 2)
            })
        end
    end

    local function updateOrbiters(kind, enabled, color)
        if not enabled or not state.allFX then
            return
        end

        local root = getRoot()
        if not root then
            return
        end

        for i, item in ipairs(orbiters) do
            if item.part and item.part.Parent then
                local angle = item.angle + orbitTime * (kind == "Runes" and 0.25 or 1)

                if kind == "Runes" then
                    item.part.Size = Vector3.new(0.08, 0.08, 0.85) * state.effectScale
                    item.part.CFrame = CFrame.new(
                        root.Position.X + math.cos(angle) * 2.1 * state.effectScale,
                        root.Position.Y - 2.6,
                        root.Position.Z + math.sin(angle) * 2.1 * state.effectScale
                    ) * CFrame.Angles(0, -angle, 0)
                else
                    item.part.Position = root.Position + Vector3.new(
                        math.cos(angle) * item.radius,
                        item.height + math.sin(orbitTime * 2 + i) * 0.2,
                        math.sin(angle) * item.radius
                    )
                end

                if kind == "Galaxy" then
                    item.part.Color = Color3.fromHSV(
                        (orbitTime * 0.1 + i / #orbiters) % 1, 0.8, 1
                    )
                else
                    item.part.Color = color
                end
            end
        end
    end

