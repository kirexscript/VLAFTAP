    --==========================================================
    -- ACCESSORIES
    --==========================================================

    local accessoryModel
    local accessoryParts = {}
    local accessoryColors = {}
    local accessoryTime = 0

    local function clearAccessories()
        if accessoryModel then
            accessoryModel:Destroy()
            accessoryModel = nil
        end
        table.clear(accessoryParts)
        table.clear(accessoryColors)
    end

    local function createAccessories()
        clearAccessories()

        local character = Player.Character
        local head = character and character:FindFirstChild("Head")
        if not head then
            return false
        end

        accessoryModel = Instance.new("Model")
        accessoryModel.Name = "VSA_Accessories"
        accessoryModel.Parent = character

        local function addPart(name, size, offset, color, shape, rotation)
            local part = Instance.new("Part")
            part.Name = name
            part.Size = size * state.effectScale
            part.Shape = shape or Enum.PartType.Block
            part.Material = Enum.Material.Neon
            part.Color = color
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.Massless = true
            part.CastShadow = false
            part.Anchored = false
            part.CFrame = head.CFrame
                * CFrame.new(offset * state.effectScale)
                * (rotation or CFrame.new())
            part.Parent = accessoryModel

            local weld = Instance.new("WeldConstraint")
            weld.Part0 = head
            weld.Part1 = part
            weld.Parent = part

            table.insert(accessoryParts, part)
            accessoryColors[part] = color
            return part
        end

        if state.accessoryStyle == "Sakura Pins" then
            for side = -1, 1, 2 do
                local x = side * 0.85
                addPart("Kanzashi", Vector3.new(0.1, 0.12, 0.8),
                    Vector3.new(x, 0.48, 0), C.Gold)

                for i = 1, 5 do
                    local angle = math.rad((i - 1) * 72)
                    addPart("Sakura Petal", Vector3.new(0.14, 0.24, 0.17),
                        Vector3.new(
                            x + math.cos(angle) * 0.18,
                            0.58 + math.sin(angle) * 0.18,
                            -0.08
                        ),
                        i % 2 == 0 and C.LightPink or C.Pink,
                        Enum.PartType.Ball)
                end

                addPart("Flower Center", Vector3.new(0.15, 0.15, 0.15),
                    Vector3.new(x, 0.58, -0.15), C.Gold, Enum.PartType.Ball)

                addPart("Leaf", Vector3.new(0.12, 0.25, 0.12),
                    Vector3.new(x - side * 0.22, 0.4, -0.06),
                    C.Green, Enum.PartType.Ball)
            end

        elseif state.accessoryStyle == "Fox Ears" or state.accessoryStyle == "Cat Ears" then
            local fox = state.accessoryStyle == "Fox Ears"
            for side = -1, 1, 2 do
                addPart("Ear", Vector3.new(0.3, fox and 0.8 or 0.55, 0.24),
                    Vector3.new(side * 0.48, fox and 0.75 or 0.62, 0),
                    state.accessoryColor,
                    Enum.PartType.Block,
                    CFrame.Angles(0, 0, math.rad(side * 15)))

                addPart("Inner Ear", Vector3.new(0.15, 0.3, 0.07),
                    Vector3.new(side * 0.48, 0.65, -0.13),
                    C.White)
            end

        elseif state.accessoryStyle == "Purple Bows" then
            for side = -1, 1, 2 do
                addPart("Bow", Vector3.new(0.4, 0.25, 0.12),
                    Vector3.new(side * 0.55, 0.58, -0.08),
                    C.Lavender, Enum.PartType.Ball)

                addPart("Bow Center", Vector3.new(0.13, 0.13, 0.13),
                    Vector3.new(side * 0.55, 0.58, -0.15),
                    C.Gold, Enum.PartType.Ball)
            end

        else
            for i = 1, 16 do
                local angle = math.rad(i * 22.5)
                addPart("Halo Light", Vector3.new(0.12, 0.12, 0.12),
                    Vector3.new(math.cos(angle), 1.25, math.sin(angle)),
                    C.Gold, Enum.PartType.Ball)
            end
        end

        return true
    end

    local function updateAccessories()
        for index, part in ipairs(accessoryParts) do
            if part and part.Parent then
                if state.accessoryRainbow and state.allFX then
                    part.Color = Color3.fromHSV(
                        (accessoryTime * 0.2 + index * 0.04) % 1,
                        0.8, 1
                    )
                elseif state.accessoryColor ~= C.Sakura then
                    part.Color = state.accessoryColor
                else
                    part.Color = accessoryColors[part] or C.Sakura
                end
            end
        end
    end

    do
        local sec = CharacterTab:AddSection("Anime Accessories")
        sec:AddDropdown({
            Name = "Accessory Style",
            Default = "Sakura Pins",
            Options = {
                "Sakura Pins",
