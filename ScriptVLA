            return
        end

        if not afterimageFolder then
            afterimageFolder = Instance.new("Folder")
            afterimageFolder.Name = "VSA_Afterimages"
            afterimageFolder.Parent = workspace
        end

        local clone = Instance.new("Model")
        clone.Name = "VSA_Afterimage"
        clone.Parent = afterimageFolder

        for _, source in ipairs(character:GetChildren()) do
            if source:IsA("BasePart") and source.Name ~= "HumanoidRootPart" then
                local part = Instance.new("Part")
                part.Name = source.Name
                part.Size = source.Size
                part.CFrame = source.CFrame
                part.Color = state.afterimageColor
                part.Material = Enum.Material.Neon
                part.Transparency = 0.55
                part.Anchored = true
                part.CanCollide = false
                part.CanTouch = false
                part.CanQuery = false
                part.CastShadow = false
                part.Parent = clone
            end
        end

        task.spawn(function()
            for i = 1, 8 do
                if not clone.Parent then
                    break
                end
                for _, part in ipairs(clone:GetChildren()) do
                    if part:IsA("BasePart") then
                        part.Transparency = 0.55 + i * 0.055
                    end
                end
                task.wait(0.04)
            end
            if clone.Parent then
                clone:Destroy()
            end
        end)
    end

