                end

                item.part.CFrame = CFrame.new(
                    root.Position + Vector3.new(
                        math.cos(item.angle) * item.radius,
                        item.height,
                        math.sin(item.angle) * item.radius
                    )
                ) * CFrame.Angles(sakuraTime, sakuraTime * 0.6, sakuraTime)

                item.part.Color = state.sakuraColor
                item.part.Transparency = 0
            end
