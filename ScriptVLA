    local function colorArray(color)
        return { color.R, color.G, color.B }
    end

    local function arrayColor(value, fallback)
        if type(value) == "table" and #value >= 3 then
            return Color3.new(
                math.clamp(tonumber(value[1]) or fallback.R, 0, 1),
                math.clamp(tonumber(value[2]) or fallback.G, 0, 1),
                math.clamp(tonumber(value[3]) or fallback.B, 0, 1)
            )
        end
        return fallback
    end

