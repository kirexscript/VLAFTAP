    local palletParts = {}
    local originalPalletColors = {}
    local lineObjects = {}
    local originalLineColors = {}
    local palletTime = 0
    local lineTime = 0

    local function isPalletPart(object)
        if not object:IsA("BasePart") then
            return false
        end
        local ancestor = object.Parent
        while ancestor and ancestor ~= workspace do
            local lowerName = string.lower(ancestor.Name)
            if string.find(lowerName, "pallet", 1, true)
                or string.find(lowerName, "palletlightbrown", 1, true) then
                return true
            end
            ancestor = ancestor.Parent
        end
        return false
    end

    local function registerObject(object)
        if isPalletPart(object) then
            palletParts[object] = true
            if not originalPalletColors[object] then
                originalPalletColors[object] = object.Color
            end
        end
        if object:IsA("Beam") or object:IsA("Trail") then
            lineObjects[object] = true
            if not originalLineColors[object] then
                originalLineColors[object] = object.Color
            end
        end
    end

    task.spawn(function()
        local stack = workspace:GetChildren()
        local processed = 0
        while #stack > 0 do
            local object = stack[#stack]
            stack[#stack] = nil
            if object then
                registerObject(object)
                local okChildren, children = pcall(function()
                    return object:GetChildren()
                end)
                if okChildren and children then
                    for _, child in ipairs(children) do
                        stack[#stack + 1] = child
                    end
                end
                processed = processed + 1
                if processed % 250 == 0 then
                    task.wait()
                end
            end
        end
    end)

    workspace.DescendantAdded:Connect(registerObject)

    local function setPallets(color)
        for part in pairs(palletParts) do
            if part and part.Parent and part.Color ~= color then
                part.Color = color
            end
        end
    end

    local function restorePallets()
        for part, color in pairs(originalPalletColors) do
            if part and part.Parent then
                part.Color = color
            end
        end
    end

    local function setLines(color)
        for object in pairs(lineObjects) do
            if object and object.Parent then
                pcall(function()
                    object.Color = ColorSequence.new(color)
                end)
            end
        end
    end

    local function restoreLines()
        for object, color in pairs(originalLineColors) do
            if object and object.Parent then
                pcall(function()
                    object.Color = color
                end)
            end
        end
    end

