    local SKY_SIZE = 1024
    local SKY_WALL_THICKNESS = 2
    local SKY_DEFAULT_COLOR = Color3.fromRGB(60, 120, 255)
    local skyCubeFolder = nil
    local skyCubeWalls = {}
