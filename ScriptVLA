    --==========================================================

    local bloomEffect = Instance.new("BloomEffect")
    bloomEffect.Name = "VSA_Bloom"
    bloomEffect.Enabled = false
    bloomEffect.Parent = Lighting

    local colorCorrection = Instance.new("ColorCorrectionEffect")
    colorCorrection.Name = "VSA_ColorCorrection"
    colorCorrection.Enabled = false
    colorCorrection.Parent = Lighting

    local function applyFog()
        if state.fog then
            Lighting.FogColor = state.fogColor
            Lighting.FogStart = math.min(state.fogStart, state.fogEnd)
            Lighting.FogEnd = math.max(state.fogEnd, state.fogStart + 1)
        else
            Lighting.FogColor = originalFog.Color
            Lighting.FogStart = originalFog.Start
            Lighting.FogEnd = originalFog.End
        end
    end

    local function updateLightingEffects()
        bloomEffect.Enabled = state.bloom and state.allFX
        bloomEffect.Intensity = state.bloomIntensity
        bloomEffect.Size = state.bloomSize

        colorCorrection.Enabled = state.colorCorrection and state.allFX
        colorCorrection.Brightness = state.brightness
        colorCorrection.Contrast = state.contrast
        colorCorrection.Saturation = state.saturation
    end

    --==========================================================
    -- GRASS / WASTEGRASS COLORS
    --==========================================================

    local grassColor = Color3.fromRGB(95, 180, 75)
    local wasteGrassColor = Color3.fromRGB(125, 145, 85)
    local rockColor = Color3.fromRGB(120, 120, 120)
    local rockColorActive = false
    local grassParts = {}
    local wasteGrassParts = {}
    local rockParts = {}
    local grassScanComplete = false

    local function isRockPart(object)
        if not object or not object:IsA("BasePart") then
            return false
        end
        local current = object
        while current and current ~= workspace do
            if string.lower(current.Name) == "rock" then
                return true
            end
            current = current.Parent
        end
        return false
    end

    local function registerRockPart(object)
        if isRockPart(object) and not rockParts[object] then
            rockParts[object] = true
            if rockColorActive then
                pcall(function() object.Color = rockColor end)
            end
        end
    end

    task.spawn(function()
        local descendants = workspace:GetDescendants()
        for index, object in ipairs(descendants) do
            if object:IsA("BasePart") then
                local lowerName = string.lower(object.Name)
                local compactName = string.gsub(lowerName, "[%s_%-]", "")
                if string.find(compactName, "wastegrass", 1, true) then
                    table.insert(wasteGrassParts, object)
                elseif compactName == "grass" or string.find(compactName, "grass", 1, true) then
                    table.insert(grassParts, object)
                end
                registerRockPart(object)
            end
            if index % 500 == 0 then
                task.wait()
            end
        end
        grassScanComplete = true
    end)

    workspace.DescendantAdded:Connect(function(object)
        if object:IsA("BasePart") then
            registerRockPart(object)
        end
    end)

    local function applyGrassColor(color)
        grassColor = color
        pcall(function()
            workspace.Terrain:SetMaterialColor(Enum.Material.Grass, color)
        end)
        for _, object in ipairs(grassParts) do
            if object and object.Parent then
                pcall(function() object.Color = color end)
            end
        end
    end

    local function applyWasteGrassColor(color)
        wasteGrassColor = color
        for _, object in ipairs(wasteGrassParts) do
            if object and object.Parent then
                pcall(function() object.Color = color end)
            end
        end
    end

    local function applyRockColor(color)
        rockColor = color
        rockColorActive = true
        for object in pairs(rockParts) do
            if object and object.Parent then
                pcall(function() object.Color = color end)
            else
                rockParts[object] = nil
            end
        end
    end

